{
  "name": "ktchn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "lint": "oxlint && eslint .",
    "types:check": "tsc --pretty --noEmit",
    "knip": "knip",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0"
  }
